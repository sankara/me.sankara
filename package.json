{
  "name": "me.sankara",
  "version": "1.0.0",
  "private": true,
  "description": "Sankara's Blog - accessibility tested",
  "scripts": {
    "build": "hugo --minify",
    "serve": "hugo server",
    "test:a11y": "hugo --minify && pa11y-ci",
